@model Customer
@{
    ViewData["Title"] = "Edit Customer";
}

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-primary"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-primary"></span>
    </div>

    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-primary"></span>
    </div>

    <div class="form-group">
        <label asp-for="Phone">Name</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-primary"></span>
    </div>
    <button type="submit" class="btn btn-dark">Save</button>
    <a class="btn btn-primary" asp-action="Index" >Index</a>
</form>