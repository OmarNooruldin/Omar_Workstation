@model Customer

@{
    ViewData["Title"] = "Details Customer Data";
}


<h1>@ViewData["Title"]</h1>

<form asp-action="/" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <textarea asp-for="Email" class="form-control"></textarea>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Address"></label>
        <textarea asp-for="Address" class="form-control"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Phone"></label>
        <textarea asp-for="Phone" class="form-control"></textarea>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <a class="btn btn-warning" asp-action="Edit" asp-route-Id="@Model.Id">Update</a>
    <a class="btn btn-danger"  asp-action="Delete" asp-route-Id="@Model.Id">Delete</a>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>
</form>