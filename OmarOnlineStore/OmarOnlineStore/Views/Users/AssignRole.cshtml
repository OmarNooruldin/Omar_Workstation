@model User
@{
    ViewData["Title"] = "Assign Roles";
    IEnumerable<Role> AllRoles = ViewBag.AllRoles;
    IEnumerable<int> AssigenedIds = ViewBag.UserRole;
}

<h2>@Model.Name Roles :</h2>
<hr>



<form asp-action="AssignRole" method="post">
    <input type="hidden" name="userId" value="@Model.Id">

    @foreach(var role in AllRoles)
        {
            <div class="form-check mb-2">
                <input class="form-check-input" 
                type="checkbox" 
                name="roleIds" 
                value="@role.Id"
                checked="@(AssigenedIds!.Contains(role.Id))">

                <label class="form-check-label">@role.Name</label>
            </div>            
        }
        <button type="submit" class="btn btn-info">Save</button>
    </form>
