@model Product

@{
    ViewData["Title"] = "Details Product Data";
}


<h1>@ViewData["Title"]</h1>

<form asp-action="/" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <textarea asp-for="Price" class="form-control"></textarea>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Image"></label>
        <textarea asp-for="Image" class="form-control"></textarea>
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Category</label>
        <input asp-for="Category.Name" class="form-control">
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>


    <a class="btn btn-warning" asp-action="Edit" asp-route-Id="@Model.Id">Update</a>
    <a class="btn btn-danger"  asp-action="Delete" asp-route-Id="@Model.Id">Delete</a>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>
</form>