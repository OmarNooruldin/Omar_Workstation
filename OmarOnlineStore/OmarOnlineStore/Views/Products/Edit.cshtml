@model Product
@{
    ViewData["Title"] = "Edit Product";
}

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-primary"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-primary"></span>
    </div>

    <div class="form-group">
        <label asp-for="Image"></label>
        <input asp-for="Image" class="form-control" />
        <span asp-validation-for="Image" class="text-primary"></span>
    </div>

    <div class="form-group">
        <label>Category</label>
        <select asp-for="CategoryId"
                asp-items="@ViewBag.Categories"
                class="form-select">
            <option value="">--Select Categories--</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-dark">Save</button>
    <a class="btn btn-primary" asp-action="Index" >Index</a>
</form>