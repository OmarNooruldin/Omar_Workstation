@model List<CardItem>
@{
    ViewData["Title"] = "Card Item" ;
}

<h1>@ViewData["Title"]</h1>


<a class="btn btn-outline-primary" asp-action="Create"> Create New Card Item</a>

<br>
<br>

<div>
    <table class="table table-bordered table-info">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Controls</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model)
            {
                <tr>
                    <td>@card.Id</td>
                    <td>@card.Name</td>
                    <td>
                        <a class="btn btn-primary" asp-action="Details" asp-route-Id="@card.Id">Details</a>
                        <a class="btn btn-success" asp-action="Edit" asp-route-Id="@card.Id">Edit</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@card.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>