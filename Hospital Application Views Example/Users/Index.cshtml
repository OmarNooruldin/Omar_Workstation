﻿@{
ViewData["Title"] = "Users Mangment";
}
@model List<User>

<h1>Users :</h1>
<hr>

<a asp-action="Create" class="btn btn-success">Create User</a>

<br />
<br />

<table class="table table-hover table-bordered table-info">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Username</th>
            <th>Password</th>
            <th>Controls</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>@user.Phone</td>
                <td>@user.Username</td>
                <td>@user.Password</td>
                <td>
                    <a class="btn btn-secondary" asp-action="Details" asp-route-Id="@user.Id">Details</a>
                    <a class="btn btn-warning" asp-action="Update" asp-route-Id="@user.Id">Update</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@user.Id">Delete</a>
                </td>
            </tr>

        }
    </table>