@model Doctor
@{
    ViewData["Title"] = "Update Doctor Information";
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="Update" method="post">
    <div class="form-group">
        <label asp-for="FirstName">First Name:</label>
        <input asp-for="FirstName" class="form-control">
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName">Last Name :</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LicenseNumber">License Number :</label>
        <input asp-for="LicenseNumber" class="form-control" />
        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConsultationFee">Consultation Fee :</label>
        <input asp-for="ConsultationFee" class="form-control" />
        <span asp-validation-for="ConsultationFee" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Department</label>
        <select asp-for="DepartmentId" asp-items="@ViewBag.Departments" class="form-select">
            <option value="">--Select Department--</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>

</form>