@model Doctor
@{
    ViewData["Title"] = "Details Doctor Information";
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="/" method="post">
    <div class="form-group">
        <label asp-for="FirstName">First Name:</label>
        <input asp-for="FirstName" class="form-control" >
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName">Last Name :</label>
        <input asp-for="LastName" class="form-control"  />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LicenseNumber">License Number :</label>
        <input asp-for="LicenseNumber" class="form-control"  />
        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConsultationFee">Consultation Fee :</label>
        <input asp-for="ConsultationFee" class="form-control"  />
        <span asp-validation-for="ConsultationFee" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Department Name:</label>
        <input asp-for="Department.Name" class="form-control" disabled>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <a class="btn btn-warning" asp-action="Update" asp-route-Id="@Model.Id">Update</a>
    <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@Model.Id">Delete</a>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>

</form>