@model Role
@{
    ViewData["Title"] = "Assign Permission";
    IEnumerable<Permission> AllPermissions = ViewBag.AllPermissions;
    IEnumerable<int> AssignedIds = ViewBag.RolePermission;
}

<h1> @ViewData["Title"] </h1>

<h2>@Model.Name Permissions : </h2>
<hr />

<form asp-action="AssignPermission" method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    @foreach (var permission in AllPermissions)
    {
        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   name="permissionIds"
                   value="@permission.Id"
                   checked="@(AssignedIds!.Contains(permission.Id))" />
            <label class="form-check-label">@permission.Id</label>
        </div>
    }

    <button type="submit" class="btn btn-dark"> Save </button>
</form>