﻿@{
ViewData["Title"] = "Roles Mangment";
}
@model List<Role>

<h1>Roles :</h1>
<hr>

<a asp-action="Create" class="btn btn-success">Create Permission</a>

<br />
<br />

<table class="table table-hover table-bordered table-info">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Controls</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Id</td>
                <td>@role.Name</td>
                <td>
                    <a class="btn btn-secondary" asp-action="Details" asp-route-Id="@role.Id">Details</a>
                    <a class="btn btn-warning" asp-action="Update" asp-route-Id="@role.Id">Update</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@role.Id">Delete</a>
                </td>
            </tr>

        }
    </table>