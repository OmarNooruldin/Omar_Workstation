@model Employee

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">

    <div>
        <p>Id     : @Model.Id</p>
        <p>Name   : @Model.Name</p>
        <p>Email  : @Model.Email</p>
        <p>City   : @Model.City</p>
        <p>Phone  : @Model.Phone</p>
        <p>Salary : @Model.Salary</p>
    </div>
</div>

