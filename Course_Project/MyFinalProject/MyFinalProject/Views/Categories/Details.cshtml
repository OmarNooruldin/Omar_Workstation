@model Category
@{
    ViewData["Title"] = "Details Category Data";
}

<h1> @ViewData["Title"]</h1>

<div>
    <form asp-action="Delete" method="post">
        <input asp-for="Id" type="hidden">
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" disabled>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description"></label>
            <input asp-for="Description" class="form-control" disabled>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <br>

        <a class="btn btn-warning" asp-action="Update" asp-route-Id="@Model.Id">Update</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-Id="@Model.Id">Delete</a>
        <a class="btn btn-primary" asp-action="Index">Home</a>
    </form>
</div>