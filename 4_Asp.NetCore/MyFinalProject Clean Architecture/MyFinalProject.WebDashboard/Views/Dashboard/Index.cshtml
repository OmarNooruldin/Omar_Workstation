@using MyFinalProject.Application.Security
﻿
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Welecome , @User.Identity?.Name</h1>
<hr />

<div class="row">
    @if(User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.CategoryView))
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body text-light bg-secondary">
                    <h4 class="card-title"><b>Categories List</b></h4>
                    <p>View and Manage Categories According to your Permission</p>
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-primary">Categories</a>
                </div>
            </div>
        </div>
    }

    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.DepartmentView))
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body text-light bg-secondary">
                    <h4 class="card-title"><b>Department</b></h4>
                    <p>View and Manage Departments According to your Permission</p>
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-primary">Departments</a>
                </div>
            </div>
        </div>
    }

    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.EmployeeView))
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body text-light bg-secondary">
                    <h4 class="card-title"><b>Employee</b></h4>
                    <p>View and Manage Employees According to your Permission</p>
                    <a asp-controller="Employees" asp-action="Index" class="btn btn-primary">Employees</a>
                </div>
            </div>
        </div>
    }

    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.ProductView))
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body text-light bg-secondary">
                    <h4 class="card-title"><b>Products</b></h4>
                    <p>View and Manage Products According to your Permission</p>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Products</a>
                </div>
            </div>
        </div>
    }
</div>
