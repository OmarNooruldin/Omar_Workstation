@using HospitalApp.Dtos
@model AppointmentUpdateDto
@{
    ViewData["Title"] = "Update Appointment";
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="Update" method="post">
    <div class="form-group">
        <label for="PatientInput">Choose a patient:</label>

        <input type="text" name="patientName" list="patientList" class="col-3" />

        <datalist id="patientList">
            @foreach (PatientListDto patient in @ViewBag.Patients)
            {
                <option value="@patient.Id">@patient.LastName</option>
            }
        </datalist>
    </div>

    <div class="form-group">
        <label asp-for="AppointmentDate">Appointment Date:</label>
        <input asp-for="AppointmentDate" class="form-control">
        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReasonForVisit">Reason For Visit :</label>
        <input asp-for="ReasonForVisit" class="form-control" />
        <span asp-validation-for="ReasonForVisit" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status">Status :</label>
        <input asp-for="Status" class="form-control" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <lable>Doctor Name :</lable>
        <select asp-for="DoctorId" asp-items="@ViewBag.Doctors" class="form-select">
            <option value=""></option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>
</form>