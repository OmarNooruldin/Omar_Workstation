@using HospitalApplication.Security
﻿
@{
    ViewData["Title"] = "Departments Management";
}
@model List<Department>

<h1 class="bg-primary text-center text-light">@ViewData["Title"]</h1>
<hr>

    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.DepartmentCreate))
    {
        <a class="btn btn-primary" asp-action="Create">Add New Department</a>
    }
<br />
<br />

<table class="table table-hover table-light">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Speciality</th>
            <th>Controls</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td>@department.Id</td>
                <td>@department.Name</td>
                <td>
                    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.DepartmentDetails))
                    {
                        <a asp-action="Details" asp-route-Id="@department.Id">Details</a>
                    }
                    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.DepartmentUpdate))
                    {
                        <a asp-action="Update" asp-route-Id="@department.Id">Update</a>
                    }
                    @if (User.HasClaim(PermissionsNames.ClaimType, PermissionsNames.DepartmentDelete))
                    {
                        <a asp-action="Delete" asp-route-Id="@department.Id">Delete</a>
                    }
                </td>
            </tr>

        }
</table>