@model ElectronicHealthRecord
@{
    ViewData["Title"] = "Delete Electric Health Record";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="VisitDate"></label>
        <input asp-for="VisitDate" class="form-control" disabled />
        <span asp-validation-for="VisitDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Diagnosis"></label>
        <input asp-for="Diagnosis" class="form-control" disabled />
        <span asp-validation-for="Diagnosis" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Symptoms"></label>
        <input asp-for="Symptoms" class="form-control" disabled />
        <span asp-validation-for="Symptoms" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Notes"></label>
        <input asp-for="Notes" class="form-control" disabled />
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>
</form>