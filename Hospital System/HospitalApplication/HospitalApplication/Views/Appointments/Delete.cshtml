@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}

<h1>@ViewData["Title"]</h1>
<hr />

 <form asp-action="Delete" method="post">
     <input asp-for="Id" type="hidden">
     
     <div class="form-group">
         <input class="form-control" asp-for="AppointmentDate" disabled />
         <label asp-for="AppointmentDate">Appointment Date :</label>
         <span asp-validation-for="AppointmentDate" class="text-bg-danger"></span>
     </div>

    <div class="form-group">
        <input class="form-control" asp-for="ReasonForVisit" disabled />
        <label asp-for="ReasonForVisit">Reason For Visit :</label>
        <span asp-validation-for="ReasonForVisit" class="text-bg-danger"></span>
    </div>

    <div class="form-group">
        <label>Patient Last Name :</label>
        <input class="form-control" asp-for="Patient.LastName" disabled />
        <span asp-validation-for="PatientId" class="text-bg-danger"></span>
    </div>

    <div class="form-group">
        <label>Doctor Id :</label>
        <input class="form-control" asp-for="StaffId" disabled />
        <span asp-validation-for="StaffId" class="text-bg-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>
 </form>