@model Billing
@{
    ViewData["Title"] = "Update Bill";
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="Update" method="post">
    <div class="form-group">
        <label asp-for="TotalAmount"></label>
        <input asp-for="TotalAmount" class="form-control">
        <span asp-validation-for="TotalAmount" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="InsuranceProvider"></label>
        <input asp-for="InsuranceProvider" class="form-control" />
        <span asp-validation-for="InsuranceProvider" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Appointment </label>
        <select class="form-select" asp-for="AppointmentId" asp-items="@ViewBag.Appointments">
            <option value="">--Select Appointment--</option>
        </select>
        <span asp-validation-for="AppointmentId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-primary" asp-action="Index">Go to Index Page</a>

</form>